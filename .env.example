# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Master key used for envelope encryption of per-document AES-256 keys and issuer private keys.
# Generate one with: py -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=

# Database (Postgres by default; set DB_ENGINE=mysql to switch to MySQL/django's mysql backend)
DB_ENGINE=postgres
POSTGRES_DB=digidocker
POSTGRES_USER=digidocker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection pooling (PgBouncer service in docker-compose)
DB_HOST_FOR_APP=pgbouncer
DB_PORT_FOR_APP=6432
